<Window x:Class="ApprovalAgent.Mock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Approval Agent — Local Mock Review"
        Width="1060"
        Height="820"
        MinWidth="740"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded"
        FontFamily="{DynamicResource UiFont}"
        FontSize="14"
        TextOptions.TextFormattingMode="Display"
        AutomationProperties.Name="Approval Agent Mock Prototype">
  <!-- Hallmark · desktop redesign · utilitarian/editorial · custom trust-console palette
       Pre-emit critique: Philosophy 5 · Hierarchy 5 · Execution 4 · Specificity 5 · Restraint 5 · Variety 4
       Invariants: mock-only actions, read-only diagnostics, warning prominence, keyboard access. -->
  <Window.Resources>
    <!-- Semantic WPF tokens: named brushes and native font stacks. -->
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="DataFont">Consolas</FontFamily>
    <SolidColorBrush x:Key="CanvasBrush" Color="#FFF4F6F3" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#FFEBF0EC" />
    <SolidColorBrush x:Key="InkBrush" Color="#FF1B2B27" />
    <SolidColorBrush x:Key="SecondaryInkBrush" Color="#FF475D55" />
    <SolidColorBrush x:Key="LineBrush" Color="#FFCFDAD3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF195C4A" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF23715B" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF104437" />
    <SolidColorBrush x:Key="FocusBrush" Color="#FF1767BA" />
    <SolidColorBrush x:Key="AlertBackgroundBrush" Color="#FFFFF0E8" />
    <SolidColorBrush x:Key="AlertForegroundBrush" Color="#FF813519" />
    <SolidColorBrush x:Key="AlertLineBrush" Color="#FFE5B79D" />
    <SolidColorBrush x:Key="PaperBrush" Color="#FFFAFBF9" />
    <SolidColorBrush x:Key="HeaderSubtleBrush" Color="#FFC5D8CE" />
    <SolidColorBrush x:Key="HeaderOutlineBrush" Color="#FF7FA495" />

    <Style x:Key="EyebrowText" TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="{StaticResource SecondaryInkBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="18" />
    </Style>
    <Style x:Key="MutedText" TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="{StaticResource SecondaryInkBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="InformationLabel" TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="{StaticResource SecondaryInkBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="InformationValue" TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ReviewCard" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="22" />
    </Style>

    <!-- A keyboard-visible ring. Border dimensions do not change on focus. -->
    <Style x:Key="KeyboardFocusRing" TargetType="{x:Type Control}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate>
            <Rectangle Stroke="{StaticResource FocusBrush}"
                       StrokeThickness="2"
                       RadiusX="9"
                       RadiusY="9"
                       Margin="-3" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ActionButton" TargetType="{x:Type Button}">
      <Setter Property="Height" Value="48" />
      <Setter Property="MinWidth" Value="140" />
      <Setter Property="Padding" Value="17,11" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="ButtonChrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.87" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.72" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.52" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryActionButton" TargetType="{x:Type Button}"
           BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="MinWidth" Value="186" />
    </Style>

    <Style x:Key="ReviewTextBox" TargetType="{x:Type TextBox}">
      <Setter Property="Background" Value="{StaticResource PaperBrush}" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}" />
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource FocusBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Background="{StaticResource CanvasBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Persistent, unambiguous simulation identity. -->
    <Border Grid.Row="0"
            Background="{StaticResource InkBrush}"
            Padding="28,15">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{StaticResource AccentHoverBrush}"
                  Width="8" Height="8" CornerRadius="4"
                  Margin="0,0,10,0" />
          <TextBlock Text="APPROVAL AGENT"
                     Foreground="{StaticResource SurfaceBrush}"
                     FontWeight="Bold" FontSize="14"
                     VerticalAlignment="Center" />
          <TextBlock Text="   /   REVIEW DESK"
                     Foreground="{StaticResource HeaderSubtleBrush}"
                     FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
        <Border Grid.Column="1"
                BorderBrush="{StaticResource HeaderOutlineBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,5"
                VerticalAlignment="Center">
          <TextBlock Text="LOCAL MOCK · NO DISPATCH"
                     Foreground="{StaticResource SurfaceBrush}"
                     FontSize="11"
                     FontWeight="SemiBold"
                     AutomationProperties.Name="Mock mode; no approval or dispatch" />
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False"
                  AutomationProperties.Name="Scrollable proposal review">
      <StackPanel MaxWidth="1080" Margin="32,28,32,32"
                  HorizontalAlignment="Stretch">
        <TextBlock Text="REQUEST REVIEW / SYNTHETIC DATA"
                   Style="{StaticResource EyebrowText}"
                   Margin="0,0,0,9" />
        <TextBlock Text="Review the complete task"
                   FontSize="30"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource InkBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6" />
        <TextBlock Text="Inspect the exact text and destination before making a local mock decision."
                   Style="{StaticResource MutedText}"
                   Margin="0,0,0,22" />

        <!-- Critical warning remains visible above the entire review content. -->
        <Border Background="{StaticResource AlertBackgroundBrush}"
                BorderBrush="{StaticResource AlertLineBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="17,15"
                Margin="0,0,0,18"
                AutomationProperties.Name="Mock prototype warning">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="5" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource AlertForegroundBrush}"
                    CornerRadius="3" />
            <StackPanel Grid.Column="1" Margin="14,0,0,0">
              <TextBlock Text="MOCK PROTOTYPE — NO REAL APPROVAL OR DISPATCH"
                         Foreground="{StaticResource AlertForegroundBrush}"
                         FontSize="14" FontWeight="Bold" TextWrapping="Wrap" />
              <TextBlock Text="This window does not send data, issue approval grants or perform Windows Hello credential operations."
                         Foreground="{StaticResource AlertForegroundBrush}"
                         TextWrapping="Wrap" Margin="0,5,0,0" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Content precedes technical diagnostics, matching the user's review task. -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="13*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="10*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource ReviewCard}">
            <StackPanel>
              <TextBlock Text="01  /  TASK CONTENT"
                         Style="{StaticResource EyebrowText}"
                         Margin="0,0,0,8" />
              <TextBlock Text="Complete task"
                         Style="{StaticResource SectionTitle}"
                         Margin="0,0,0,5" />
              <TextBlock Text="Read the entire message. This is the exact text used for the task hash."
                         Style="{StaticResource MutedText}"
                         Margin="0,0,0,15" />
              <TextBox Style="{StaticResource ReviewTextBox}"
                       Text="{Binding Proposal.Task, Mode=OneWay}"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       FontFamily="{StaticResource DataFont}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Disabled"
                       MinHeight="230"
                       MaxHeight="350"
                       AutomationProperties.Name="Complete task content, read only"
                       AutomationProperties.HelpText="Read all task content. This field cannot be edited." />
              <TextBlock Text="TASK SHA-256"
                         Style="{StaticResource EyebrowText}"
                         Margin="0,18,0,7" />
              <TextBlock Text="{Binding Proposal.TaskSha256}"
                         Foreground="{StaticResource SecondaryInkBrush}"
                         FontFamily="{StaticResource DataFont}"
                         FontSize="12"
                         TextWrapping="Wrap"
                         AutomationProperties.Name="Task SHA-256 hash" />
            </StackPanel>
          </Border>

          <StackPanel Grid.Column="2">
            <Border Style="{StaticResource ReviewCard}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="02  /  DESTINATION"
                           Style="{StaticResource EyebrowText}"
                           Margin="0,0,0,8" />
                <TextBlock Text="Request details"
                           Style="{StaticResource SectionTitle}"
                           Margin="0,0,0,17" />
                <TextBlock Text="Provider" Style="{StaticResource InformationLabel}" />
                <TextBlock Text="{Binding Proposal.Provider}"
                           Style="{StaticResource InformationValue}"
                           AutomationProperties.Name="Provider" />
                <Border Height="1" Background="{StaticResource LineBrush}"
                        Margin="0,13" />
                <TextBlock Text="Model" Style="{StaticResource InformationLabel}" />
                <TextBlock Text="{Binding Proposal.Model}"
                           Style="{StaticResource InformationValue}"
                           AutomationProperties.Name="Model" />
                <Border Height="1" Background="{StaticResource LineBrush}"
                        Margin="0,13" />
                <TextBlock Text="External API destination"
                           Style="{StaticResource InformationLabel}" />
                <TextBlock Text="{Binding Proposal.Destination}"
                           Foreground="{StaticResource InkBrush}"
                           FontFamily="{StaticResource DataFont}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="External API destination" />
                <Border Height="1" Background="{StaticResource LineBrush}"
                        Margin="0,13" />
                <TextBlock Text="Expires (UTC)" Style="{StaticResource InformationLabel}" />
                <TextBlock Text="{Binding ExpiresAtDisplay}"
                           Style="{StaticResource InformationValue}"
                           AutomationProperties.Name="Expiration time in UTC" />
              </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceMutedBrush}"
                    CornerRadius="10" Padding="17">
              <StackPanel>
                <TextBlock Text="EXTERNAL TRANSMISSION WARNING"
                           Style="{StaticResource EyebrowText}"
                           Margin="0,0,0,9" />
                <TextBlock Text="{Binding ExternalTransmissionWarning}"
                           Foreground="{StaticResource InkBrush}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="External transmission warning" />
                <TextBlock Text="The destination uses the reserved .invalid domain."
                           Foreground="{StaticResource SecondaryInkBrush}"
                           FontSize="12" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,11,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <!-- Technical details are available, not placed above the task decision. -->
        <Border x:Name="WebAuthnDiagnosticsSection"
                Style="{StaticResource ReviewCard}"
                Margin="0,18,0,0"
                AutomationProperties.Name="Read-only Windows WebAuthn capability diagnostics">
          <Expander IsExpanded="False"
                    Foreground="{StaticResource InkBrush}"
                    AutomationProperties.Name="Toggle read-only Windows WebAuthn diagnostics">
            <Expander.Header>
              <StackPanel Margin="0,0,0,2">
                <TextBlock Text="READ-ONLY / WINDOWS WEBAUTHN"
                           Style="{StaticResource EyebrowText}"
                           Margin="0,0,0,5" />
                <TextBlock Text="Capability diagnostics"
                           Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Version and availability are informational, not identity or permission evidence."
                           Style="{StaticResource MutedText}"
                           Margin="0,5,0,0" />
              </StackPanel>
            </Expander.Header>
            <StackPanel Margin="3,18,0,0">
              <TextBlock Text="No credential operation or user-verification prompt is performed."
                         Foreground="{StaticResource SecondaryInkBrush}"
                         TextWrapping="Wrap" Margin="0,0,0,12" />
              <TextBlock Text="{Binding LibraryStatus, StringFormat='webauthn.dll: {0}'}"
                         TextWrapping="Wrap"
                         AutomationProperties.Name="WebAuthn DLL availability" />
              <TextBlock Text="{Binding ApiStatus, StringFormat='Native API: {0}'}"
                         TextWrapping="Wrap"
                         AutomationProperties.Name="Native WebAuthn API availability" />
              <TextBlock Text="{Binding VersionStatus, StringFormat='API version: {0}'}"
                         TextWrapping="Wrap"
                         AutomationProperties.Name="WebAuthn API version support" />
              <TextBlock Text="{Binding AuthenticatorStatus, StringFormat='User-verifying platform authenticator: {0}'}"
                         TextWrapping="Wrap"
                         AutomationProperties.Name="Platform authenticator availability" />
              <TextBlock Text="{Binding ErrorStatus, StringFormat='Diagnostic details: {0}'}"
                         TextWrapping="Wrap" Margin="0,8,0,0"
                         AutomationProperties.Name="WebAuthn diagnostic errors" />
              <TextBlock Text="Structured test-only capability report"
                         Foreground="{StaticResource InkBrush}"
                         FontWeight="SemiBold" Margin="0,16,0,8" />
              <TextBox Style="{StaticResource ReviewTextBox}"
                       Text="{Binding StructuredReportJson, Mode=OneWay}"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       FontFamily="{StaticResource DataFont}"
                       FontSize="12"
                       TextWrapping="NoWrap"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Auto"
                       MinHeight="140"
                       MaxHeight="220"
                       AutomationProperties.Name="Read-only WebAuthn capability report" />
              <TextBlock Text="Availability does not prove Windows Hello enrollment, credential presence, user identity, application integrity, or USER approval."
                         Foreground="{StaticResource SecondaryInkBrush}"
                         FontWeight="SemiBold" TextWrapping="Wrap"
                         Margin="0,13,0,0" />
            </StackPanel>
          </Expander>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Fixed decision footer: status and actions remain accessible while scrolling. -->
    <Border Grid.Row="2"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,1,0,0"
            Padding="28,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
          <TextBlock Text="LOCAL DECISION · NOTHING IS TRANSMITTED"
                     Style="{StaticResource EyebrowText}" Margin="0,0,0,5" />
          <TextBlock Text="{Binding StatusMessage}"
                     Foreground="{StaticResource InkBrush}"
                     FontWeight="SemiBold" TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite"
                     AutomationProperties.Name="Mock decision status" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="_Reject"
                  Style="{StaticResource ActionButton}"
                  Margin="0,0,10,0"
                  IsEnabled="{Binding CanReject}"
                  Click="Reject_Click"
                  AutomationProperties.Name="Reject mock proposal" />
          <Button Content="Approve _Mock (local)"
                  Style="{StaticResource PrimaryActionButton}"
                  IsEnabled="{Binding CanApprove}"
                  Click="ApproveMock_Click"
                  AutomationProperties.Name="Approve mock proposal only" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
